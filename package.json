{
  "name": "paperboat",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "engine/toolkit/src/*/*/web",
    "engine/toolkit/src/*/web",
    "engine/toolkit/*/*/web",
    "engine/toolkit/*/web"
  ],
  "scripts": {
    "dev": "npm run dev -w @paperboat/web --",
    "build": "npm run build -w @paperboat/web && npm run build:cli",
    "build:cli": "npm run build -w @paperboat/cli",
    "build:release": "npm exec -w @paperboat/web -- vite build && npm run bundle -w @paperboat/cli",
    "cli": "./bin/paperboat",
    "typecheck": "npm run typecheck -w @paperboat/web && npm run typecheck -w @paperboat/cli",
    "e2e": "npm run e2e -w @paperboat/web --",
    "backend:workbench": "cmake --build engine/build --target paperboat-workbench && engine/build/workbench/paperboat-workbench",
    "backend:thermostat": "./bin/paperboat run 01",
    "backend:cart-pole": "./bin/paperboat run 02",
    "backend:island": "./bin/paperboat run 03",
    "backend:cocktail": "./bin/paperboat run 04",
    "backend:rover": "./bin/paperboat run 05",
    "backend:robot": "./bin/paperboat run 06",
    "backend:cfd": "./bin/paperboat run 07",
    "backend:air-hockey": "./bin/paperboat run 08",
    "backend:synth": "./bin/paperboat run 09",
    "backend:pantograph": "./bin/paperboat run 10",
    "smoke": "python3 protocol/smoke_test.py --port",
    "build:python": "cmake -S python -B python/build > /dev/null && cmake --build python/build",
    "golden": "npm run build:python --silent && python3 protocol/golden.py",
    "docs": "./scripts/build_docs.sh",
    "test:python": "npm run build:python --silent && python3 -m pytest -q python/tests",
    "gen:protocol": "python3 protocol/gen_ts.py",
    "verify": "./scripts/verify.sh"
  }
}
