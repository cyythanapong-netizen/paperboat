{
  "name": "paperboat",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @paperboat/web --",
    "build": "npm run build -w @paperboat/web",
    "typecheck": "npm run typecheck -w @paperboat/web",
    "backend:mass-spring": "./bin/paperboat run mass-spring",
    "backend:cart-pole": "./bin/paperboat run cart-pole",
    "backend:parametric": "./bin/paperboat run parametric",
    "backend:runner": "./bin/paperboat run runner",
    "backend:animation": "./bin/paperboat run animation",
    "smoke": "python3 protocol/smoke_test.py --port",
    "backend:parts": "./bin/paperboat run parts",
    "backend:chain": "./bin/paperboat run chain",
    "backend:supply": "./bin/paperboat run supply",
    "backend:double-pendulum": "./bin/paperboat run double-pendulum --port 8773",
    "build:python": "cmake -S python -B python/build > /dev/null && cmake --build python/build",
    "golden": "npm run build:python --silent && python3 protocol/golden.py",
    "docs": "./scripts/build_docs.sh",
    "publish:dev": "python3 scripts/publish.py",
    "test:python": "npm run build:python --silent && python3 -m pytest -q python/tests",
    "gen:protocol": "python3 protocol/gen_ts.py"
  }
}
