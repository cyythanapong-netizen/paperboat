// The backend's program: register the domain's blocks, load the descriptor, serve.
//   build/@target@ [--port N]   serve the protocol (default ws://localhost:@port@)
//   build/@target@ --run        run the starter graph once, headless: JSON lines
#include <paperboat/sdk.hpp>

#include "domain/blocks.hpp"

int main(int argc, char** argv) {
  // Static: catalog entries point into the registry, so both live as long as the server.
  static const paperboat::Registry registry = [] {
    paperboat::Registry r = paperboat::builtins();  // the toolkit's packages (base, signal, dashboard…)
    domain::add_blocks(r);  // the domain's own (domain/blocks.hpp)
    return r;
  }();
  static const paperboat::Catalog catalog = paperboat::load_descriptor_file(PAPERBOAT_DESCRIPTOR, registry);
  // A run lasts 5 s of the run clock (dt 0.01 s); the UI may change it per run.
  return paperboat::main({.engine = "@name@", .catalog = &catalog, .run = {.duration = 5.0}}, argc, argv, @port@);
}
