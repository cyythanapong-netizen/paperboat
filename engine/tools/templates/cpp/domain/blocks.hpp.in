// The domain's own blocks. Add a block: a class (what runs) and its definition (what the
// palette shows), then use its type in descriptor.toml. Reference: docs/api (C++ API).
#pragma once

#include <paperboat/sdk.hpp>

namespace domain {

// A block owns its params and any state it keeps between steps; step() runs once per pass
// of the clock and turns its inputs into its outputs.
struct Scale final : paperboat::Block {
  explicit Scale(const paperboat::Values& params) : gain(paperboat::get_or(params, "gain")) {}

  paperboat::Values step(const paperboat::Context& /*ctx*/, const paperboat::Values& in) override {
    // ctx.log("text", "warn") writes to the Console, tagged with this block.
    return {{"y", gain * paperboat::get_or(in, "u")}};
  }

  double gain;
};

inline void add_blocks(paperboat::Registry& r) {
  r.add(paperboat::define_block<Scale>("@name@", {.type = "scale",
                                                  .label = "Scale",
                                                  .inputs = {{"u"}},
                                                  .outputs = {{"y"}},
                                                  .params = {{.id = "gain", .default_value = 2}},
                                                  .description = "Multiplies its input by a gain."}));
}

}  // namespace domain
