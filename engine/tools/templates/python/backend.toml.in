# The backend's manifest: what `paperboat run`, `check` and `pack` read.
[backend]
format = 0
name = "@name@"
version = "0.1.0"
engine = ">=0.1"
language = "python"
run = "server.py"
# `paperboat run` serves ws://localhost:@port@ (`paperboat run --port N` for another).
port = @port@
descriptor = "descriptor.toml"

[test]
# `paperboat check` runs the starter graph headless and compares what it ends with to this.
golden = "expected.json"
