# Embeds templates/<language>/** (the files `paperboat new` writes) in a C++ source, so the
# command works from an installed package with no source checkout. Run in tools/CMakeLists.txt;
# editing or adding a template re-runs CMake (CONFIGURE_DEPENDS).
#   paperboat_embed_templates(<output.cpp>)
function(paperboat_embed_templates out)
  set(root ${CMAKE_CURRENT_SOURCE_DIR}/templates)
  file(GLOB_RECURSE files RELATIVE ${root} CONFIGURE_DEPENDS ${root}/*.in)
  list(SORT files)
  set(text "// Generated by CMake from engine/tools/templates (new_templates.cmake): the files `paperboat new`\n")
  string(APPEND text "// writes. Edit the templates, not this file.\n#include \"paperboat_new.hpp\"\n\n")
  string(APPEND text "namespace paperboat::cli {\nnamespace {\nconst TemplateFile kFiles[] = {\n")
  foreach(rel IN LISTS files)
    file(READ ${root}/${rel} content)
    if(content MATCHES "\\)pbtpl\"")
      message(FATAL_ERROR "templates/${rel} contains the raw string delimiter )pbtpl\"")
    endif()
    string(FIND "${rel}" "/" slash)
    string(SUBSTRING "${rel}" 0 ${slash} language)
    math(EXPR start "${slash} + 1")
    string(SUBSTRING "${rel}" ${start} -1 path)
    string(REGEX REPLACE "\\.in$" "" path "${path}")
    string(APPEND text "    {\"${language}\", \"${path}\", R\"pbtpl(${content})pbtpl\"},\n")
  endforeach()
  string(APPEND text "};\n}  // namespace\n\nstd::span<const TemplateFile> templates() { return kFiles; }\n}  // namespace paperboat::cli\n")
  # Only touch the output when it changed, so a re-run of CMake doesn't recompile it.
  file(WRITE ${out}.tmp "${text}")
  configure_file(${out}.tmp ${out} COPYONLY)
endfunction()
