{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": { "@paperboat/host": ["./src/host.ts"] }
  },
  "include": ["src", "vite.config.ts", "../../engine/toolkit/src/*/*/web", "../../engine/toolkit/src/*/web", "../../engine/toolkit/*/*/web", "../../engine/toolkit/*/web"]
}
