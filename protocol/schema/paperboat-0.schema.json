{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperboat.dev/protocol/paperboat-0.schema.json",
  "title": "Paperboat protocol v0",
  "description": "Every message between the UI and a backend. Generated by hand from protocol/README.md; the source of truth for message shapes. protocol/golden.py and protocol/smoke_test.py validate every message a backend sends against it.",
  "$defs": {
    "PortDef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "ParamDef": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "default"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "const": "number"
            },
            "default": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "default"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "const": "boolean"
            },
            "default": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "default"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text",
                "key",
                "file"
              ]
            },
            "default": {
              "type": "string"
            }
          }
        }
      ]
    },
    "BlockDef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "source",
            "probe",
            "function",
            "monitor"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortDef"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortDef"
          }
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamDef"
          }
        },
        "group": {
          "type": "string"
        },
        "linked": {
          "type": "boolean"
        },
        "instrument": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "kind",
        "inputs",
        "outputs",
        "params"
      ],
      "additionalProperties": false
    },
    "ObjectDef": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "enum": [
            "body",
            "joint"
          ]
        },
        "group": {
          "type": "string"
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParamDef"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "block": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "label",
        "role",
        "props",
        "links"
      ],
      "additionalProperties": false
    },
    "Entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "shape": {
          "enum": [
            "box",
            "sphere",
            "line",
            "image"
          ]
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "size": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "rot": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "to": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "color": {
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "View": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "2d",
            "3d"
          ]
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "height": {
          "type": "number"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "group": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "Edge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "to": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "Graph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Group"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "StationObject": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "links": {
          "type": "object"
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "Station": {
      "type": "object",
      "properties": {
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StationObject"
          }
        }
      },
      "required": [
        "objects"
      ],
      "additionalProperties": false
    },
    "hello": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "protocol": {
          "const": "paperboat/0"
        },
        "engine": {
          "type": "string"
        },
        "station": {
          "type": "object",
          "properties": {
            "view": {
              "enum": [
                "scene",
                "graph",
                "web"
              ]
            },
            "page": {
              "type": "string"
            }
          },
          "required": [
            "view"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "type",
        "protocol",
        "engine"
      ],
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BlockDef"
          }
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ObjectDef"
          }
        }
      },
      "required": [
        "type",
        "blocks"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        },
        "view": {
          "$ref": "#/$defs/View"
        }
      },
      "required": [
        "type",
        "entities"
      ],
      "additionalProperties": false
    },
    "scene.patch": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Entity"
          }
        }
      },
      "required": [
        "type",
        "entities"
      ],
      "additionalProperties": false
    },
    "graph.load": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        }
      },
      "required": [
        "type",
        "graph"
      ],
      "additionalProperties": false
    },
    "station.load": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "station": {
          "$ref": "#/$defs/Station"
        }
      },
      "required": [
        "type",
        "station"
      ],
      "additionalProperties": false
    },
    "run.started": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "run": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "run"
      ],
      "additionalProperties": false
    },
    "run.progress": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "type",
        "run",
        "fraction"
      ],
      "additionalProperties": false
    },
    "run.finished": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "run": {
          "type": "string"
        },
        "status": {
          "enum": [
            "done",
            "failed",
            "cancelled"
          ]
        }
      },
      "required": [
        "type",
        "run",
        "status"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "t": {
          "type": "number"
        },
        "v": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "required": [
        "type",
        "node",
        "t",
        "v"
      ],
      "additionalProperties": false
    },
    "node.state": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "done",
            "failed"
          ]
        }
      },
      "required": [
        "type",
        "node",
        "state"
      ],
      "additionalProperties": false
    },
    "log": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "level": {
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "text": {
          "type": "string"
        },
        "node": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "level",
        "text"
      ],
      "additionalProperties": false
    },
    "graph.run": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "graph": {
          "$ref": "#/$defs/Graph"
        },
        "station": {
          "$ref": "#/$defs/Station"
        }
      },
      "required": [
        "type",
        "graph"
      ],
      "additionalProperties": false
    },
    "station.set": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "station": {
          "$ref": "#/$defs/Station"
        }
      },
      "required": [
        "type",
        "station"
      ],
      "additionalProperties": false
    },
    "run.cancel": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "down": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "key",
        "down"
      ],
      "additionalProperties": false
    },
    "toUI": {
      "title": "Backend → UI",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "hello",
            "catalog",
            "scene",
            "scene.patch",
            "graph.load",
            "station.load",
            "run.started",
            "run.progress",
            "run.finished",
            "signal",
            "node.state",
            "log"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "hello"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/hello"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "catalog"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/catalog"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/scene"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene.patch"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/scene.patch"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "graph.load"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/graph.load"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "station.load"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/station.load"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.started"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/run.started"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.progress"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/run.progress"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.finished"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/run.finished"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "signal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/signal"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "node.state"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/node.state"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "log"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/log"
          }
        }
      ]
    },
    "toBackend": {
      "title": "UI → Backend",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "graph.run",
            "station.set",
            "run.cancel",
            "input"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "graph.run"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/graph.run"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "station.set"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/station.set"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "run.cancel"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/run.cancel"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "input"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/input"
          }
        }
      ]
    },
    "Group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "nodes"
      ],
      "description": "A group of blocks. visual: tidies the canvas only. story: runs as one step of a Step flow (ports in → next), its blocks once per clock step for params.seconds (0: once).",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "visual",
            "story"
          ]
        },
        "label": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "collapsed": {
          "type": "boolean"
        },
        "pos": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "params": {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    }
  },
  "$ref": "#/$defs/toUI"
}
