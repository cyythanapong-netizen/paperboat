model DCMotor "DC motor driving an inertia through a spring-damper"
  import Modelica.Electrical.Analog;
  import Modelica.Mechanics.Rotational;
  parameter Modelica.Units.SI.Resistance R = 1 "Armature resistance";
  parameter Modelica.Units.SI.Inductance L = 0.05 "Armature inductance";
  parameter Real k(unit = "N.m/A") = 0.5 "Motor constant";
  parameter Modelica.Units.SI.Inertia J_motor = 0.01 "Rotor inertia";
  parameter Modelica.Units.SI.Inertia J_load = 0.05 "Load inertia";
  parameter Modelica.Units.SI.RotationalSpringConstant c = 10 "Shaft stiffness";
  parameter Modelica.Units.SI.RotationalDampingConstant d = 1 "Shaft damping";
  Modelica.Blocks.Interfaces.RealInput v(unit = "V") "Armature voltage";
  Modelica.Blocks.Interfaces.RealOutput w(unit = "rad/s") "Load speed";
  Modelica.Blocks.Interfaces.RealOutput phi(unit = "rad") "Load angle";
  Real i(unit = "A") = l.i annotation(__paperboat(probe = true));
  Analog.Sources.SignalVoltage source;
  Analog.Basic.Resistor r(R = R);
  Analog.Basic.Inductor l(L = L, i(start = 0, fixed = true));
  Analog.Basic.RotationalEMF emf(k = k);
  Analog.Basic.Ground ground;
  Rotational.Components.Inertia rotor(J = J_motor);
  Rotational.Components.SpringDamper shaft(c = c, d = d);
  Rotational.Components.Inertia load(J = J_load, phi(start = 0, fixed = true), w(start = 0, fixed = true));
  Rotational.Sensors.SpeedSensor speed;
  Rotational.Sensors.AngleSensor angle;
equation
  connect(v, source.v);
  connect(source.p, r.p);
  connect(r.n, l.p);
  connect(l.n, emf.p);
  connect(emf.n, source.n);
  connect(source.n, ground.p);
  connect(emf.flange, rotor.flange_a);
  connect(rotor.flange_b, shaft.flange_a);
  connect(shaft.flange_b, load.flange_a);
  connect(load.flange_b, speed.flange);
  connect(load.flange_b, angle.flange);
  connect(speed.w, w);
  connect(angle.phi, phi);
end DCMotor;
